---
// src/components/Calendario.astro — El mes en grilla, con el día de los
// XV marcado en oro. Recibe la fecha por props para no repetir la
// cuenta en cada componente que lo usa.
//
// Sin marco: va suelto sobre el vino del layout, con Cormorant Garamond
// en vez de la romana Cinzel — más suave, menos solemne.
interface Props {
    anio: number;
    mes: number; // 1 = enero … 12 = diciembre
    dia: number; // día a marcar
}

const { anio, mes, dia } = Astro.props;

const DIAS_SEMANA = ["D", "L", "M", "M", "J", "V", "S"];
const NOMBRES_MES = [
    "Enero",
    "Febrero",
    "Marzo",
    "Abril",
    "Mayo",
    "Junio",
    "Julio",
    "Agosto",
    "Septiembre",
    "Octubre",
    "Noviembre",
    "Diciembre",
];

const nombreMes = NOMBRES_MES[mes - 1];

const arranque = new Date(anio, mes - 1, 1).getDay(); // huecos antes del 1
const diasDelMes = new Date(anio, mes, 0).getDate();

const celdas: (number | null)[] = [
    ...Array(arranque).fill(null),
    ...Array.from({ length: diasDelMes }, (_, i) => i + 1),
];
while (celdas.length % 7 !== 0) celdas.push(null);

const semanas = Array.from({ length: celdas.length / 7 }, (_, i) =>
    celdas.slice(i * 7, i * 7 + 7),
);
---

<div id="calendario-suelto" class="calendario-suelto">
    <img
        src="/imagenes/sombrero2.png"
        alt=""
        width="598"
        height="782"
        aria-hidden="true"
        class="sombrero-calendario select-none"
    />

    <p class="font-cormorant mes-calendario">{nombreMes} {anio}</p>

    <span class="linea-calendario"></span>

    <div class="almanaque">
        <div class="fila-semana encabezado-almanaque">
            {DIAS_SEMANA.map((letra) => <span class="celda-almanaque">{letra}</span>)}
        </div>

        {
            semanas.map((semana) => (
                <div class="fila-semana">
                    {semana.map((numero) => (
                        <span
                            class:list={[
                                "font-cormorant celda-almanaque",
                                numero === dia && "dia-marcado",
                            ]}
                        >
                            {numero ?? ""}
                        </span>
                    ))}
                </div>
            ))
        }
    </div>
</div>

<style>
    /* Card de vidrio: un borde dorado fino y blur detrás, sin volutas
       ni filete doble — mucho más sobrio que el marco de la carta. */
    .calendario-suelto {
        position: relative;
        width: 100%;
        max-width: 320px;
        margin: 0 auto;
        container-type: inline-size;
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 8% 6% 7%;
        border: 1px solid rgba(201, 164, 92, 0.5);
        border-radius: 14px;
        background: rgba(58, 12, 16, 0.28);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        box-shadow:
            0 8px 26px rgba(10, 2, 4, 0.35),
            0 0 0 1px rgba(0, 0, 0, 0.08) inset;
    }

    .sombrero-calendario {
        width: min(20%, 76px);
        height: auto;
        margin-bottom: 1rem;
        filter: drop-shadow(0 5px 12px rgba(10, 2, 4, 0.7));
    }

    .mes-calendario {
        color: #e4c179;
        font-style: italic;
        font-size: 5.4cqw;
        letter-spacing: 0.08em;
        text-indent: 0.08em;
        text-transform: uppercase;
        text-shadow: 0 2px 6px rgba(10, 2, 4, 0.75);
    }

    .linea-calendario {
        width: 34cqw;
        height: 1px;
        margin-top: 1.6cqw;
        background: rgba(201, 164, 92, 0.6);
    }

    .almanaque {
        width: 100%;
        margin-top: 3.4cqw;
    }

    .fila-semana {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
    }

    .celda-almanaque {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 9cqw;
        font-size: 5.4cqw;
        color: #e9d9b8;
    }

    .encabezado-almanaque .celda-almanaque {
        font-weight: 600;
        color: #dcc9ab;
        font-size: 5cqw;
    }

    /* El día de los XV, en oro sobre el vino, sin degradado */
    .dia-marcado {
        position: relative;
        z-index: 0;
        color: #3a0c10;
        font-weight: 600;
    }

    .dia-marcado::before {
        content: "";
        position: absolute;
        left: 50%;
        top: 50%;
        width: 8.6cqw;
        height: 8.6cqw;
        margin: -4.3cqw 0 0 -4.3cqw;
        border-radius: 9999px;
        background: #dbb164;
        box-shadow: 0 0 10px rgba(201, 164, 92, 0.5);
        z-index: -1;
    }
</style>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener("DOMContentLoaded", () => {
        const calendario = document.getElementById("calendario-suelto");
        if (!calendario) return;

        /*
           Todo arranca en el mismo instante; lo que cambia es de dónde
           viene cada pieza: el sombrero baja, el mes crece, la línea se
           traza desde el centro, los días de la semana bajan y los
           números suben. Todos salen de un desenfoque leve que se
           disipa, para que se sienta suave y no un golpe seco.
        */
        /*
           toggleActions = onEnter | onLeave | onEnterBack | onLeaveBack.
           "restart" al entrar bajando la reproduce de cero cada vez;
           "reset" al salir por arriba la deja escondida, lista para la
           próxima bajada. Así la animación se repite siempre que se
           vuelve a pasar por la sección, no una sola vez.
        */
        const tl = gsap.timeline({
            scrollTrigger: {
                trigger: calendario,
                start: "top 85%",
                toggleActions: "restart none none reset",
            },
        });

        const suave = "power2.out";
        const salida = { opacity: 0, filter: "blur(7px)" };
        const juntos = 0; // todas las piezas arrancan acá

        const anima = (sel: string, extra: object, duration: number) => {
            const el = calendario.querySelector(sel);
            if (el) tl.from(el, { ...salida, ...extra, duration, ease: suave }, juntos);
        };

        // El sombrero baja desde arriba
        anima(".sombrero-calendario", { y: -24, scale: 0.9 }, 1.3);

        // El mes se abre apenas desde su centro
        anima(".mes-calendario", { scale: 0.94 }, 1.4);

        // La línea se traza sola, abriéndose desde el centro
        anima(".linea-calendario", { scaleX: 0, transformOrigin: "center center" }, 1.5);

        // Las letras de los días bajan desde arriba, en cascada corta
        const cabecera = calendario.querySelectorAll(
            ".encabezado-almanaque .celda-almanaque",
        );
        if (cabecera.length) {
            tl.from(
                cabecera,
                {
                    ...salida,
                    y: -12,
                    duration: 1.2,
                    ease: suave,
                    stagger: { each: 0.03, from: "center" },
                },
                juntos,
            );
        }

        /*
           Los números suben desde abajo, con un roce de 0.015s entre
           celda y celda que sale del centro hacia afuera: se lee como
           una sola aparición con onda, no como una lista cargándose.
        */
        const numeros = calendario.querySelectorAll(
            ".fila-semana:not(.encabezado-almanaque) .celda-almanaque",
        );
        if (numeros.length) {
            tl.from(
                numeros,
                {
                    ...salida,
                    y: 10,
                    duration: 1.2,
                    ease: suave,
                    stagger: { each: 0.015, from: "center", grid: "auto" },
                },
                juntos,
            );
        }

        // El día marcado asienta último, creciendo despacio
        const marcado = calendario.querySelector(".dia-marcado");
        if (marcado) {
            tl.from(marcado, { scale: 0.5, duration: 1.6, ease: suave }, juntos);
        }
    });
</script>
