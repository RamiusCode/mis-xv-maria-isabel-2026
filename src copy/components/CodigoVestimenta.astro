---
// src/components/CodigoVestimenta.astro
// Código de vestimenta, mismo estilo que RecepcionSocial: sin fondo,
// oro sobre el vino del layout, Great Vibes para el título y
// Callingstone para el resto del texto.
// ── DATOS EDITABLES ───────────────────────────────────────────
const titulo = "Código de Vestimenta";
const etiqueta = "MUGGLE FORMAL";
// ──────────────────────────────────────────────────────────────
---

<section id="vestimenta" class="relative w-full overflow-hidden">
    <!-- Polvo de oro, igual que en el resto de las secciones -->
    <span class="mota mota-1" aria-hidden="true"></span>
    <span class="mota mota-2" aria-hidden="true"></span>
    <span class="mota mota-3" aria-hidden="true"></span>
    <span class="mota mota-4" aria-hidden="true"></span>

    <div
        id="bloque-vestimenta"
        class="relative flex flex-col items-center px-8 py-6 text-center"
    >
        <h2 class="titulo-vestimenta">{titulo}</h2>

        <span class="linea-vestimenta"></span>

        <!-- Con su color original, sin máscara -->
        <img
            src="/imagenes/vestimenta.png"
            alt=""
            width="455"
            height="572"
            aria-hidden="true"
            class="dibujo-vestimenta select-none"
        />

        <p class="etiqueta-vestimenta">{etiqueta}</p>
    </div>
</section>

<style>
    /* ── Polvo de oro ───────────────────────────────────────────── */
    .mota {
        position: absolute;
        width: 3px;
        height: 3px;
        border-radius: 9999px;
        background: #e7c689;
        box-shadow: 0 0 7px 1px rgba(231, 198, 137, 0.85);
        opacity: 0;
        pointer-events: none;
        animation: polvo-vestimenta 5.2s ease-in-out infinite;
    }

    .mota-1 {
        left: 9%;
        top: 14%;
        animation-delay: 0s;
    }

    .mota-2 {
        right: 8%;
        top: 24%;
        animation-delay: 1.3s;
    }

    .mota-3 {
        left: 11%;
        bottom: 28%;
        animation-delay: 2.4s;
    }

    .mota-4 {
        right: 10%;
        bottom: 20%;
        animation-delay: 3.4s;
    }

    @keyframes polvo-vestimenta {
        0%,
        100% {
            opacity: 0;
            transform: translateY(6px) scale(0.6);
        }
        50% {
            opacity: 1;
            transform: translateY(-8px) scale(1);
        }
    }

    /* Mismo ancho de referencia que Dedicatoria/RecepcionSocial: los
       cqw de abajo quedan a la misma escala en toda la invitación. */
    #bloque-vestimenta {
        container-type: inline-size;
    }

    .dibujo-vestimenta {
        width: 54%;
        max-width: 220px;
        height: auto;
        margin-top: 1.6rem;
        filter: drop-shadow(0 4px 10px rgba(10, 2, 4, 0.55));
    }

    .titulo-vestimenta {
        font-family: "Great Vibes", cursive;
        color: #e4c179;
        font-size: 14cqw;
        line-height: 1.3;
        margin-top: 0.6rem;
        text-shadow:
            0 1px 0 rgba(122, 82, 27, 0.6),
            0 3px 9px rgba(10, 2, 4, 0.85);
    }

    .linea-vestimenta {
        width: 15rem;
        max-width: 60%;
        height: 1px;
        margin-top: 0.9rem;
        background: rgba(201, 164, 92, 0.6);
    }

    .etiqueta-vestimenta {
        font-family: "Callingstone", cursive;
        color: #dcc9ab;
        font-size: 6.4cqw;
        letter-spacing: 0.06em;
        line-height: 1.5;
        margin-top: 0.9rem;
        text-shadow: 0 2px 6px rgba(10, 2, 4, 0.75);
    }
</style>

<script>
    import { animarEntrada } from "../scripts/animaciones";

    document.addEventListener("DOMContentLoaded", () => {
        const bloque = document.getElementById("bloque-vestimenta");
        if (bloque) animarEntrada(bloque.children, bloque);
    });
</script>
